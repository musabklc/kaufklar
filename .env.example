# Kopiere diese Datei nach .env.local und trage deine Werte ein. .env.local wird nie eingecheckt.

# --- KI (kostenlos) ---------------------------------------------------------
# Google Gemini API-Schlüssel, gratis unter https://aistudio.google.com → "Get API key".
# Hinweis: Im Gratis-Tarif nutzt Google die Eingaben zur Produktverbesserung (siehe Datenschutzseite).
GEMINI_API_KEY=
# Optional, Standard: gemini-3.8-flash
GEMINI_MODEL=
# KI-Recherche der Schwachstellen per Google-Suche. NUR im bezahlten Gemini-Tarif (Billing aktiv;
# 5.000 Suchen/Monat inklusive). Im Gratis-Tarif auf false lassen.
GEMINI_SEARCH_ENABLED=false

# --- Tachoklar-Preisindex (Supabase, Gratis-Tarif reicht) ---------------------
# Dashboard → Connect (Project URL) und Settings → API Keys (Secret key, beginnt mit sb_secret_).
# Der Secret Key gehört NUR auf den Server – niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Link-Import ---------------------------------------------------------------
# AutoScout24 und Kleinanzeigen werden direkt gelesen; mobile.de blockt automatische Abrufe bewusst –
# dort leitet die App zum Screenshot-Weg. Nutzungsbedingungen der Portale vor öffentlichem Betrieb rechtlich prüfen.
LINK_IMPORT_ENABLED=false

# --- Wöchentlicher Rückruf-Import (Vercel Cron) ---------------------------------
# Beliebige lange Zufallszeichenkette; Vercel sendet sie automatisch an /api/cron/recalls.
CRON_SECRET=

# --- Forum-Login (Supabase Auth) – öffentliche Werte, landen im Browser ---
# Dashboard → Settings → API Keys → Publishable key. Nur sicher mit RLS (siehe supabase/migrations/*forum*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-Mails für Preisalarm und Forum-Antworten (Resend, https://resend.com) – Absender noreply@tachoklar.de
RESEND_API_KEY=

# Kostenkontrolle: KI-Aufrufe pro Tag über alle Nutzer (Standard 500)
AI_DAILY_LIMIT=

# Premium-Bericht (Stripe). Erst einschalten, wenn Gewerbe, AGB und Widerrufsbelehrung stehen.
PREMIUM_ENABLED=false
# Am besten ein eingeschränkter Schlüssel (rk_…) mit Schreibrecht für Checkout Sessions
STRIPE_SECRET_KEY=
# Signing Secret des Webhook-Endpunkts https://tachoklar.de/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
