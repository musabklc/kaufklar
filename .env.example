# Kopiere diese Datei nach .env.local und trage deine Werte ein. .env.local wird nie eingecheckt.

# --- KI (kostenlos) ---------------------------------------------------------
# Google Gemini API-Schlüssel, gratis unter https://aistudio.google.com → "Get API key".
# Hinweis: Im Gratis-Tarif nutzt Google die Eingaben zur Produktverbesserung (siehe Datenschutzseite).
GEMINI_API_KEY=
# Optional, Standard: gemini-3.8-flash
GEMINI_MODEL=
# Websuche nach Vergleichsangeboten. Funktioniert NUR im bezahlten Gemini-Tarif (Billing aktiv;
# 5.000 Suchen/Monat inklusive). Im Gratis-Tarif auf false lassen.
GEMINI_SEARCH_ENABLED=false

# Alternative: Anthropic Claude (kostenpflichtig). Wird nur genutzt, wenn kein GEMINI_API_KEY gesetzt ist.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Kaufklar-Preisindex (Supabase, Gratis-Tarif reicht) ---------------------
# Dashboard → Connect (Project URL) und Settings → API Keys (Secret key, beginnt mit sb_secret_).
# Der Secret Key gehört NUR auf den Server – niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Link-Import ---------------------------------------------------------------
# AutoScout24 und Kleinanzeigen werden direkt gelesen; mobile.de blockt automatische Abrufe bewusst –
# dort leitet die App zum Screenshot-Weg. Nutzungsbedingungen der Portale vor öffentlichem Betrieb rechtlich prüfen.
LINK_IMPORT_ENABLED=false

# --- Wöchentlicher Rückruf-Import (Vercel Cron) ---------------------------------
# Beliebige lange Zufallszeichenkette; Vercel sendet sie automatisch an /api/cron/recalls.
CRON_SECRET=
